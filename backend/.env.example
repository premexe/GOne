# ─────────────────────────────────────────────────────
# LifeLink Backend — Complete .env.example
# Copy this to .env and fill in your real values.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── JWT Auth ──────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-something-very-random-and-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── OCR (Poppler path — Windows only) ────────────────
POPPLER_PATH=C:\path\to\poppler\Library\bin

# ── G-ONE AI / Gemini ─────────────────────────────────
# Leave blank to use Deterministic/Ollama fallback
GEMINI_API_KEY=your_gemini_api_key_here

# ── Bland AI — Real-Time AI Phone Call ───────────────
# Create an API key at https://app.bland.ai/
BLAND_API_KEY=your_bland_api_key_here
BLAND_VOICE=maya

# Your public HTTPS backend URL (must be reachable by Bland AI webhooks)
# For local dev: use a public HTTPS tunnel, then paste the URL here
# For Render:    https://lifelink-backend-1tzq.onrender.com
PUBLIC_BACKEND_URL=https://lifelink-backend-1tzq.onrender.com

# Keep false for automated testing and routine development. Set true only when
# a real SOS should place a paid Bland AI call and the URL above is public HTTPS.
ENABLE_SOS_VOICE_CALLS=false

# ── Vapi AI — Authenticated outbound calls ────────────
# Keep these values in backend/.env only. Create an assistant and import a
# verified outbound phone number in the Vapi dashboard.
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# ── Email Delivery — Resend (SMTP) ────────────────────
# Sign up at https://resend.com/, then go to SMTP section.
# Add + verify a domain in Resend before using a custom EMAIL_FROM.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key_here

# The sender address — must match a verified domain in Resend
EMAIL_FROM=LifeLink Emergency <alerts@yourdomain.com>
