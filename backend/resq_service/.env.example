# Server Configuration
HOST=0.0.0.0
# 8000 is already used by the existing G-ONE backend.
PORT=8001
ENVIRONMENT=development

# LLM Providers (Only Genuine Free Tiers)
# 1. Google Gemini (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq (Free tier from Groq Cloud: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Used for multilingual speech transcription fallback (99+ languages).
GROQ_STT_MODEL=whisper-large-v3-turbo

# STT Provider (Sarvam AI for Indian Languages: https://dashboard.sarvam.ai/)
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3

# G-ONE Backend Hospital Handover Integration
GONE_BACKEND_URL=http://127.0.0.1:8000
GONE_HANDOVER_ENDPOINT=/api/v1/emergency/handover
USE_MOCK_HANDOVER=true
