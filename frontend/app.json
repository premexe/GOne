{
  "expo": {
    "name": "G-ONE",
    "slug": "lifelink-ai-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "lifelink",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifelink.aiplus",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow G-ONE to transcribe emergency voice notes.",
        "NSMicrophoneUsageDescription": "Allow G-ONE to record emergency voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.lifelink.aiplus",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow G-ONE to use Face ID to unlock your emergency workspace."
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow G-ONE to record emergency voice notes.",
          "speechRecognitionPermission": "Allow G-ONE to transcribe emergency voice notes.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05fe2fc5-7dbf-4c73-8394-31377994b5c6"
      }
    }
  }
}
