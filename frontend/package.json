{
  "name": "lifelink-ai-plus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --offline",
    "start:clear": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --clear --offline",
    "android": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --android --offline",
    "ios": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --ios --offline",
    "web": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --web --offline",
    "build": "npx expo export -p web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/virtualized-lists": "^0.81.5",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-agora": "^4.6.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@types/react",
        "typescript"
      ]
    }
  }
}
