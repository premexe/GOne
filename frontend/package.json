{
  "name": "lifelink-ai-plus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx --node-options=\"--max-old-space-size=8192\" expo start --offline",
    "android": "npx --node-options=\"--max-old-space-size=8192\" expo start --android --offline",
    "ios": "npx --node-options=\"--max-old-space-size=8192\" expo start --ios --offline",
    "web": "npx --node-options=\"--max-old-space-size=8192\" expo start --web --offline",
    "build": "npx expo export -p web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/virtualized-lists": "^0.81.5",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^57.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "lucide-react-native": "^1.33.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@types/react",
        "typescript"
      ]
    }
  }
}
