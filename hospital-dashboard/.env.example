# Safe default. The complete dashboard works without a backend in mock mode.
VITE_DATA_MODE=mock

# FastAPI base URL. Used only when VITE_DATA_MODE=api.
# Local: http://localhost:8000
# Production: https://lifelink-backend-1tzq.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Existing Phase 3 road-routing provider (no API key required).
VITE_OSRM_BASE_URL=https://router.project-osrm.org
